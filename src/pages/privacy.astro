---
import '../styles/global.css'
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Menu from '../components/Menu.astro'
import Footer from '../components/Footer.astro'
import background from '../assets/background.png'

const headingClass =
  'text-transparent font-bold bg-clip-text bg-gradient-to-br from-amber-600 to-amber-400 tracking-tight'
---

<Layout
  title="Maintainerr — Privacy Policy"
  description="Maintainerr's Privacy Policy: how we use cookies and handle your information."
>
  <div class="relative min-h-screen w-full">
    <!-- Background Image -->
    <Image
      src={background}
      alt=""
      width={1344}
      height={768}
      format="webp"
      quality={60}
      loading="eager"
      class="fixed top-0 left-0 w-full h-full object-cover object-[center_25%] z-[-5]"
    />

    <!-- Gradient Overlay -->
    <div
      class="fixed inset-0 bg-gradient-to-b from-[#070a0f]/60 to-black z-[-4] pointer-events-none"
    >
    </div>

    <Menu />

    <section class="px-4 max-w-7xl m-auto my-8">
      <div
        class="bg-zinc-800 rounded-lg p-8 md:p-12 text-zinc-300 leading-relaxed"
      >
        <h1 class={`${headingClass} text-3xl md:text-4xl mb-4`}>
          Privacy Policy
        </h1>
        <p class="mb-4">
          Your privacy is important to us. This privacy policy explains how we
          use cookies and collect, store, and handle your information when you
          use our documentation website.
        </p>

        <h2 class={`${headingClass} text-xl md:text-2xl mt-8 mb-2`}>
          What Are Cookies?
        </h2>
        <p class="mb-4">
          Cookies are small text files that are stored on your device when you
          visit a website. They are used to improve your browsing experience and
          provide insights into how our website is used.
        </p>

        <h2 class={`${headingClass} text-xl md:text-2xl mt-8 mb-2`}>
          How We Use Cookies
        </h2>
        <p class="mb-2">We use cookies for the following purposes:</p>
        <ul class="list-disc pl-6 mb-4 space-y-1">
          <li>
            To analyze user interactions with our documentation to identify
            areas for improvement.
          </li>
          <li>
            To ensure that our website is functioning correctly and efficiently.
          </li>
          <li>To remember user preferences, such as consent to analytics.</li>
          <li>To track highly trafficked pages of the documentation.</li>
          <li>
            To collect user feedback through the use of our feedback widgets
            (only shown when analytics consent is given).
          </li>
        </ul>

        <h2 class={`${headingClass} text-xl md:text-2xl mt-8 mb-2`}>
          We Do Not Sell Your Information
        </h2>
        <p class="mb-4">
          We want to make it explicitly clear that we <strong
            class="text-white font-semibold">do not</strong
          > sell or share your information with third parties for marketing or advertising
          purposes. The data we collect through cookies is used exclusively to improve
          our documentation and enhance your experience.
        </p>

        <h2 class={`${headingClass} text-xl md:text-2xl mt-8 mb-2`}>
          Your Choices
        </h2>
        <p class="mb-2">
          You have full control over your cookie preferences. You can:
        </p>
        <ul class="list-disc pl-6 mb-4 space-y-1">
          <li>
            Accept cookies to help us analyze and improve our documentation.
          </li>
          <li>
            Reject cookies to disable analytics and prevent the storage of
            non-essential cookies.
          </li>
        </ul>
        <p class="mb-4">
          If you have previously accepted cookies, you can revoke your consent
          at any time through our cookie management settings.
        </p>

        <h2 class={`${headingClass} text-xl md:text-2xl mt-8 mb-2`}>
          Contact Us
        </h2>
        <p class="mb-4">
          If you have any questions or concerns about this privacy policy or how
          your data is handled, please feel free to contact us at
          <a
            href="mailto:get@maintainerr.info"
            class="text-amber-500 hover:text-amber-400 font-semibold"
            >get@maintainerr.info</a
          >.
        </p>

        <h2 class={`${headingClass} text-xl md:text-2xl mt-8 mb-2`}>
          Changes to This Policy
        </h2>
        <p>
          We may update this privacy policy from time to time to reflect changes
          in our practices or for other operational, legal, or regulatory
          reasons. We encourage you to review this page periodically to stay
          informed about how we are protecting your information.
        </p>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
