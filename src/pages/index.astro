---
import '../styles/global.css'
import { Image } from 'astro:assets'
import Menu from '../components/Menu.astro'
import Layout from '../layouts/Layout.astro'
import Title from '../components/Title.astro'
import Top from '../components/Top.astro'
import Middle from '../components/Middle.astro'
import Bottom from '../components/Bottom.astro'
import Solution from '../components/Solution.astro'
import Faq from '../components/Faq.astro'
import Footer from '../components/Footer.astro'
import background from '../assets/background.png'
---

<Layout>
  <div class="relative min-h-screen w-full">
    <!-- Background Image -->
    <Image
      src={background}
      alt=""
      width={1344}
      height={768}
      format="webp"
      quality={60}
      loading="eager"
      class="fixed top-0 left-0 w-full h-full object-cover z-[-5]"
    />

    <!-- Gradient Overlay -->
    <div
      class="fixed inset-0 bg-gradient-to-b from-[#070a0f]/60 to-black z-[-4] pointer-events-none"
    >
    </div>
    <Menu />
    <Title />
    <Top />
    <Middle />
    <Bottom />
    <Solution />
    <Faq />
    <Footer />
  </div>
</Layout>
