---
// Live Discord stats fetched at build time (graceful fallback if unavailable).
let online: number | null = null
let members: number | null = null
let iconUrl: string | null = null
try {
  const res = await fetch(
    'https://discord.com/api/v9/invites/WP4ZW2QYwk?with_counts=true',
  )
  if (res.ok) {
    const d = await res.json()
    online =
      typeof d.approximate_presence_count === 'number'
        ? d.approximate_presence_count
        : null
    members =
      typeof d.approximate_member_count === 'number'
        ? d.approximate_member_count
        : null
    const g = d.guild ?? {}
    if (g.id && g.icon)
      iconUrl = `https://cdn.discordapp.com/icons/${g.id}/${g.icon}.png`
  }
} catch {
  // ignore — render the card without live counts
}
const fmt = (n: number | null) => (n == null ? null : n.toLocaleString('en-US'))
const inviteUrl = 'https://discord.maintainerr.info/'
---

<!-- The box at the bottom for Installation Link and Docs-->
<div class="px-4 max-w-7xl mb-8 m-auto">
  <div class="bg-zinc-600 rounded-lg">
    <div class="grid md:grid-cols-2 grid-cols-1 items-center">
      <div class="justify-center items-center p-8">
        <h2 class="font-bold text-3xl mb-4 text-white">
          <span>Sound like the solution?</span>
        </h2>
        <p class="text-zinc-300 font-semibold pb-6">
          Maintainerr works with Plex, Jellyfin, and Emby, and is easy to get up
          and running with Docker. You can find instructions and tutorials in
          our documentation. If you need help, feel free to reach out.
        </p>
        <div class="py-6 flex flex-wrap gap-4 justify-center md:justify-start">
          <a
            href="https://docs.maintainerr.info/installation"
            target="_blank"
            class="text-white font-semibold bg-amber-600 hover:bg-amber-500 transition-colors rounded-lg p-4"
            >Installation</a
          >
          <a
            href="https://docs.maintainerr.info/"
            target="_blank"
            class="text-white font-semibold bg-amber-600 hover:bg-amber-500 transition-colors rounded-lg p-4"
            >Documentation</a
          >
        </div>
      </div>

      <!-- Discord community invite card -->
      <div class="p-6 flex justify-center md:justify-start">
        <div
          class="w-full max-w-sm overflow-hidden rounded-lg bg-[#2b2d31] shadow-xl"
        >
          <div
            class="h-20 bg-gradient-to-r from-amber-600 via-amber-500 to-amber-800"
          >
          </div>
          <div class="px-5 pb-5">
            <img
              src={iconUrl ?? '/favicon.ico'}
              alt="Maintainerr Discord server icon"
              width="64"
              height="64"
              loading="lazy"
              decoding="async"
              class="-mt-8 h-16 w-16 rounded-2xl border-4 border-[#2b2d31] bg-[#2b2d31]"
            />
            <div class="mt-2 flex items-center gap-1.5">
              <span class="text-lg font-bold text-white">Maintainerr</span>
            </div>
            {
              (online != null || members != null) && (
                <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-zinc-400">
                  {online != null && (
                    <span class="flex items-center gap-1.5">
                      <span class="inline-block h-2 w-2 rounded-full bg-green-500" />
                      {fmt(online)} Online
                    </span>
                  )}
                  {members != null && (
                    <span class="flex items-center gap-1.5">
                      <span class="inline-block h-2 w-2 rounded-full bg-zinc-500" />
                      {fmt(members)} Members
                    </span>
                  )}
                </div>
              )
            }
            <p class="mt-3 text-sm text-zinc-300">
              Get help, share overlay templates, and chat with the community.
            </p>
            <a
              href={inviteUrl}
              target="_blank"
              rel="noopener"
              class="mt-4 block rounded bg-[#248046] py-2.5 text-center font-semibold text-white transition-colors hover:bg-[#1a6334]"
              >Join our Discord</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
