---
import { Icon } from 'astro-icon/components'
---

<div class="px-4 max-w-7xl mb-8 m-auto">
  <div
    class="bg-gradient-to-r from-[#d97706] to-[#996207] via-[#dd8f0c] rounded-lg"
  >
    <div class="py-16 px-8 max-w-7xl mx-auto">
      <div
        class="text-white tracking-tight font-extrabold text-3xl leading-9 m-0"
      >
        A library management system built to help you save space.
      </div>
      <p class="text-white text-lg mt-1">
        Maintainerr was created to assist you in freeing up storage space. Here
        are some of its useful features :
      </p>
      <div
        class="grid mt-16 text-white gap-x-6 gap-y-6"
        style="grid-template-columns: repeat(auto-fit, minmax(325px, 1fr));"
      >
        <div>
          <div>
            <Icon name="solid/object-group" />
            <style>
              [data-icon='solid/object-group'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Collection Management</div>
            <p class="text-zinc-200 pr-4">
              Make Collections from a specific set of rules, defined by you.
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/film" />
            <style>
              [data-icon='solid/film'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Media Server Overview</div>
            <p class="text-zinc-200 pr-4">
              See an overview of your media library contents (Plex, Jellyfin, and Emby)
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/plus" />
            <style>
              [data-icon='solid/plus'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Manual Control</div>
            <p class="text-zinc-200 pr-4">
              Manually add or remove media, and exclude items from a collection
              even when they match a rule
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/house-chimney-user" />
            <style>
              [data-icon='solid/house-chimney-user'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Media Server Collections</div>
            <p class="text-zinc-200 pr-4">
              Show your new collection on your media server home screen
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/clock-rotate-left" />
            <style>
              [data-icon='solid/clock-rotate-left'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Countdown Timer</div>
            <p class="text-zinc-200 pr-4">
              Set a number of days the collection will exist before its contents
              are deleted
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/calendar-days" />
            <style>
              [data-icon='solid/calendar-days'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Deletion Calendar</div>
            <p class="text-zinc-200 pr-4">
              See exactly when scheduled deletions and *arr actions will run, in
              a month or week calendar view.
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="regular/handshake" />
            <style>
              [data-icon='regular/handshake'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">*arr Integration</div>
            <p class="text-zinc-200 pr-4">
              Set Radarr and Sonarr to either remove or unmonitor media in the
              collection
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="regular/eye" />
            <style>
              [data-icon='regular/eye'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Seerr Integration</div>
            <p class="text-zinc-200 pr-4">Auto clear requests from Seerr</p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/warehouse" />
            <style>
              [data-icon='solid/warehouse'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Storage Management</div>
            <p class="text-zinc-200 pr-4">Remove media from disk</p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/list-check" />
            <style>
              [data-icon='solid/list-check'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Tautulli Integration</div>
            <p class="text-zinc-200 pr-4">
              Use information and statistics from your Tautulli installation.
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/chart-line" />
            <style>
              [data-icon='solid/chart-line'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Streamystats Integration</div>
            <p class="text-zinc-200 pr-4">
              Build rules from Streamystats watch data (Jellyfin) for sharper
              cleanup decisions.
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/bell" />
            <style>
              [data-icon='solid/bell'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Notifications</div>
            <p class="text-zinc-200 pr-4">
              Stay in the loop with alerts via Discord, Telegram, Slack, Email,
              Gotify, Ntfy, Pushover, Pushbullet, LunaSea, and Webhooks.
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/wand-magic-sparkles" />
            <style>
              [data-icon='solid/wand-magic-sparkles'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Poster Overlays</div>
            <p class="text-zinc-200 pr-4">
              Brand collection items with custom poster and title-card overlays,
              like a "Leaving soon" badge, designed in a visual editor.
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/image" />
            <style>
              [data-icon='solid/image'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Custom Collection Posters</div>
            <p class="text-zinc-200 pr-4">
              Upload your own artwork for a collection. Maintainerr pushes it to
              your media server and restores it on recreation.
            </p>
          </div>
        </div>
        <div>
          <div>
            <Icon name="solid/right-left" />
            <style>
              [data-icon='solid/right-left'] {
                font-size: 2.5rem;
                background-color: orange;
                padding: 0.5rem;
                border-radius: 8px;
                margin-bottom: 2px;
              }
            </style>
          </div>
          <div>
            <div class="font-bold text-lg mb-2">Switch Media Servers</div>
            <p class="text-zinc-200 pr-4">
              Move between Plex, Jellyfin, and Emby, with automatic rule
              migration.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
