---
import { Image } from 'astro:assets'
import '../styles/global.css'
import CollectionInfo from '../assets/screenshots/CollectionInfo.png'
import Rules from '../assets/screenshots/Rules.png'
import Collections from '../assets/screenshots/Collections.png'
import Ruleconfig from '../assets/screenshots/Ruleconfig.png'
import Rulesetup from '../assets/screenshots/Rulesetup.png'
import Settings from '../assets/screenshots/Settings.png'
import Overlays from '../assets/screenshots/Overlays.png'
import OverlayShowcase from '../assets/screenshots/OverlayShowcase.png'
import StorageMetrics from '../assets/screenshots/StorageMetrics.png'
import Calendar from '../assets/screenshots/Calendar.png'
---

<div class="px-[2rem] py-[4rem]">
  <div class="gap-14 max-w-7xl grid grid-cols-1 md:grid-cols-2 m-auto">
    <div class="text-stone-400 font-semibold">
      <div
        class="text-transparent font-extrabold text-2xl mb-4 bg-clip-text bg-gradient-to-br from-amber-600 to-amber-400 tracking-tight"
      >
        The Best Way to Manage Your Library
      </div>
      <p>
        Maintainerr helps you find those outlying media items that have just
        been sitting there in your library. If you use Seerr, it is easy for
        your users to start downloading everything they can think of. Sometimes,
        they don't even watch it.
      </p>
      <hr class="w-full h-2 my-4" />

      <p>
        Utilize multiple parameters across
        <a href="https://www.plex.tv" style="color:#f59e0b" target="_blank"
          >Plex</a
        >,
        <a href="https://jellyfin.org" style="color:#f59e0b" target="_blank"
          >Jellyfin</a
        >,
        <a href="https://emby.media" style="color:#f59e0b" target="_blank"
          >Emby</a
        >,
        <a href="https://sonarr.tv" style="color:#f59e0b" target="_blank"
          >Sonarr</a
        >,
        <a href="https://radarr.video" style="color:#f59e0b" target="_blank"
          >Radarr</a
        >,
        <a href="https://tautulli.com" style="color:#f59e0b" target="_blank"
          >Tautulli</a
        >,
        <a
          href="https://github.com/fredrikburmester/streamystats"
          style="color:#f59e0b"
          target="_blank">Streamystats</a
        >, and
        <a href="https://seerr.dev" style="color:#f59e0b" target="_blank"
          >Seerr</a
        >
        to find unwatched/unwanted media, and get rid of it.
      </p>
    </div>
    <div class="md:-mr-[6rem]">
      <div id="default-carousel" class="relative w-full" data-carousel="slide">
        <div class="relative h-40 overflow-hidden rounded-lg md:h-96">
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={Collections}
              alt="Collections overview screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={CollectionInfo}
              alt="Collection detail screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={Rules}
              alt="Rules list screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={Ruleconfig}
              alt="Rule configuration screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={Rulesetup}
              alt="Rule setup screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={Overlays}
              alt="Overlay template editor screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={OverlayShowcase}
              alt="Leaving soon poster overlay examples"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={StorageMetrics}
              alt="Storage metrics screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={Calendar}
              alt="Deletion calendar screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="hidden duration-500 ease-linear" data-carousel-item>
            <Image
              src={Settings}
              alt="Settings screenshot"
              class="absolute block w-full md:h-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2"
              width={1280}
              height={800}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Screenshot lightbox (native <dialog>: Escape-to-close, backdrop, focus trapping for free) -->
  <dialog
    id="screenshot-lightbox"
    class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-4 backdrop:bg-black/90"
  >
    <div class="flex h-full w-full items-center justify-center">
      <!-- Close -->
      <button
        id="lightbox-close"
        type="button"
        aria-label="Close"
        class="absolute top-4 right-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-2xl text-white transition-colors hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
      >
        &times;
      </button>

      <!-- Previous -->
      <button
        id="lightbox-prev"
        type="button"
        aria-label="Previous screenshot"
        class="absolute left-4 z-10 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-3xl text-white transition-colors hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
      >
        &#8249;
      </button>

      <img
        id="screenshot-lightbox-img"
        src=""
        alt="Expanded screenshot"
        class="max-h-full max-w-[85vw] rounded-lg shadow-2xl"
      />

      <!-- Next -->
      <button
        id="lightbox-next"
        type="button"
        aria-label="Next screenshot"
        class="absolute right-4 z-10 flex h-12 w-12 items-center justify-center rounded-full bg-white/10 text-3xl text-white transition-colors hover:bg-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
      >
        &#8250;
      </button>
    </div>
  </dialog>

  <style>
    #default-carousel img {
      cursor: zoom-in;
    }
  </style>

  <script>
    const lightbox = document.getElementById(
      'screenshot-lightbox',
    ) as HTMLDialogElement | null
    const lightboxImg = document.getElementById(
      'screenshot-lightbox-img',
    ) as HTMLImageElement | null
    const carousel = document.getElementById('default-carousel')
    const images = Array.from(carousel?.querySelectorAll('img') ?? [])
    let current = 0

    const show = (index: number) => {
      if (!lightboxImg || images.length === 0) return
      current = (index + images.length) % images.length
      const img = images[current] as HTMLImageElement
      lightboxImg.src = img.currentSrc || img.src
      lightboxImg.alt = img.alt
    }

    images.forEach((img, i) =>
      img.addEventListener('click', () => {
        show(i)
        lightbox?.showModal()
      }),
    )

    document
      .getElementById('lightbox-close')
      ?.addEventListener('click', () => lightbox?.close())
    document
      .getElementById('lightbox-prev')
      ?.addEventListener('click', () => show(current - 1))
    document
      .getElementById('lightbox-next')
      ?.addEventListener('click', () => show(current + 1))

    // Click the backdrop / padding area (but not the image or buttons) to close.
    lightbox?.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('img, button')) lightbox.close()
    })

    // Escape is handled natively by <dialog>; we add gallery arrow navigation.
    document.addEventListener('keydown', (e) => {
      if (!lightbox?.open) return
      if (e.key === 'ArrowLeft') show(current - 1)
      else if (e.key === 'ArrowRight') show(current + 1)
    })
  </script>
</div>
